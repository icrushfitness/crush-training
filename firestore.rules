rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open sign-up for testing: any signed-in member can use the app.
    // Each member can only read and write their own data.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /workouts/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
